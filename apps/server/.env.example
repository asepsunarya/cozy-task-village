# PostgreSQL connection string. Leave empty to use the embedded PGlite database
# stored in apps/server/data/ (zero setup, single process).
DATABASE_URL=postgres://localhost:5432/cozy_village

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=warn

# Allowed browser origin for cross-origin API calls (the Vite dev server proxies, so this rarely matters).
WEB_ORIGIN=http://localhost:5173

# Demo simulation pacing and how many agents may work at once.
DEMO_TICK_MS=1400
MAX_CONCURRENT_RUNS=5

# Set to false in production to disable POST /api/reset.
ALLOW_RESET=true
